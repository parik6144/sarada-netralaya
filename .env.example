# Local dev (auto-created by `npm run dev`)
DATABASE_URL="file:./db/dev.db"

# Vercel: add ALL mail vars below — .env is NOT deployed with the site.
# MAIL_NOTIFY_TO is where booking alerts go (info@saradanetralaya.org).
# MAIL_USERNAME / MAIL_PASSWORD must be a working Gmail app password (sender account).

APP_NAME="SARADA Netralaya & Maternity"

# Set these in Vercel → Project → Settings → Environment Variables
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SARADA Netralaya & Maternity"
MAIL_NOTIFY_TO=info@saradanetralaya.org
