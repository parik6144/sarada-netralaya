generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Appointment {
  id            String   @id @default(cuid())
  patientName   String
  phone         String
  email         String?
  doctor        String
  department    String
  preferredDate String
  preferredTime String
  symptoms      String?
  hasInsurance  Boolean  @default(false)
  insuranceName String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
